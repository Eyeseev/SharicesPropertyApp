# Copy to .env.local and fill in. Never commit real values.
# Random secret for signing sessions, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Google OAuth client (Vic creates this in Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated list of the two allowed Google account emails
ALLOWED_EMAILS=
# Local test sign-in (development and tests only; ignored in production builds)
# AUTH_TEST_MODE=1
# Base URL of the app for Auth.js callbacks in local development (Vercel sets this automatically)
NEXTAUTH_URL=http://localhost:3000
